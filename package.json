{
  "name": "audiobookphile-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next && next build",
    "start": "next start",
    "lint": "oxlint . && eslint .",
    "lint:fast": "oxlint .",
    "typecheck": "tsc --noEmit",
    "types:sync": "cd ../audiobookphile-backend && supabase gen types typescript --linked > ../audiobookphile-web/src/types/supabase.ts",
    "test": "playwright test",
    "test:unit": "bun test src/__tests__",
    "test:ui": "playwright test --ui",
    "lint:fix": "oxlint . --fix && eslint . --fix",
    "format": "biome format --write src/ && prettier --write .",
    "format:fast": "biome format --write src/",
    "sync:ios": "bun run scripts/generate-swift-models.ts",
    "prepare": "node -e \"if (!process.env.CI) require('child_process').execSync('lefthook install', {stdio:'inherit'});\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@floating-ui/react-dom": "^2.1.9",
    "@formkit/drag-and-drop": "^0.5.3",
    "@next/playwright": "^16.3.3",
    "@sentry/nextjs": "^10.71.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.5",
    "@tanstack/react-query-devtools": "^5.102.5",
    "backblaze-b2": "^1.7.1",
    "clsx": "^2.1.1",
    "cronstrue": "^3.24.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.43.0",
    "hls.js": "^1.7.1",
    "isomorphic-dompurify": "^3.23.0",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "next-intl": "^4.13.7",
    "posthog-js": "^1.421.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-transition-group": "^4.4.5",
    "slate": "^0.118.1",
    "slate-history": "^0.113.1",
    "slate-react": "^0.117.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tus-js-client": "^4.3.1",
    "vgpu": "^0.5.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.10",
    "@eslint/eslintrc": "^3.3.6",
    "@evilmartians/lefthook": "^2.1.10",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.62.1",
    "@size-limit/preset-app": "^12.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-transition-group": "^4.4.12",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@webgpu/types": "^0.1.74",
    "axe-core": "^4.13.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-types": "^1.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "oxlint": "^1.80.0",
    "prettier-plugin-sort-json": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rolldown": "^1.2.6",
    "size-limit": "^12.1.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "~5.9.3"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "error"
    },
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.15.0",
    "bun": ">=1.4.0"
  },
  "size-limit": [
    {
      "path": ".next/static/chunks/**/*.js",
      "limit": "1.5 MB",
      "running": false
    }
  ]
}
