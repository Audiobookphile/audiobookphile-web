{
  "name": "audiobookphile-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "rm -rf .next && bun --bun next build && bun run typecheck",
    "start": "bun --bun next start",
    "clean": "rm -rf .next",
    "prelint": "bun run scripts/require-canary.ts",
    "lint": "bun lint",
    "lint:fix": "bun lint --fix",
    "preformat": "bun run scripts/require-canary.ts",
    "typecheck": "bun run scripts/tsrs.ts --noEmit",
    "typecheck:tsrs": "bun run scripts/tsrs.ts --noEmit",
    "typecheck:watch": "bun run scripts/tsrs.ts --watch --noEmit",
    "types:sync": "bun run scripts/sync-types.ts",
    "supabase": "bun run scripts/supabase.ts",
    "db:push": "bun run scripts/supabase.ts db push",
    "functions:deploy": "bun run scripts/supabase.ts functions deploy api --no-verify-jwt",
    "size": "bun run scripts/size-budget.ts",
    "lhci": "bun x lhci",
    "test": "bun run --bun playwright test",
    "test:unit": "bun test",
    "test:unit:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:ui": "bun run --bun playwright test --ui",
    "format": "bun fmt && bun run scripts/sort-locales.ts",
    "format:check": "bun fmt --check",
    "audit": "bun audit --production --ignore GHSA-vfj7-8cjw-p6xm --ignore GHSA-3g3m-2fjr-6pw4 --ignore GHSA-g3hv-75wg-m249 --ignore GHSA-mrhx-c7xc-m3w5",
    "audit:all": "bun audit --ignore GHSA-vfj7-8cjw-p6xm --ignore GHSA-jmr9-qjv8-65gv --ignore GHSA-7pqw-9j4j-h8q3 --ignore GHSA-hp3w-g68c-fv3c --ignore GHSA-3g3m-2fjr-6pw4 --ignore GHSA-g3hv-75wg-m249 --ignore GHSA-27r3-jxmh-p828 --ignore GHSA-mrhx-c7xc-m3w5",
    "scan": "bun pm scan",
    "prepare": "bun run scripts/prepare.ts"
  },
  "trustedDependencies": [
    "@evilmartians/lefthook",
    "@sentry/cli",
    "@swc/core",
    "@vgpu/adapter-node",
    "supabase",
    "webgpu"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@floating-ui/react-dom": "^2.1.9",
    "@formkit/drag-and-drop": "^0.7.0",
    "@sentry/nextjs": "^10.78.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "backblaze-b2": "^1.7.1",
    "clsx": "^2.1.1",
    "cronstrue": "^3.38.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "hls.js": "^1.7.4",
    "isomorphic-dompurify": "^3.23.0",
    "lucide-react": "^1.70.0",
    "next": "16.5.0-canary.20",
    "next-intl": "^4.14.9",
    "postgres": "^4.1.0",
    "posthog-js": "^1.447.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-transition-group": "^4.4.5",
    "slate": "^0.118.1",
    "slate-history": "^0.113.1",
    "slate-react": "^0.117.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tus-js-client": "^4.3.1",
    "vgpu": "^0.5.0",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
    "@next/playwright": "^16.5.0-canary.47",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tsrs/wasm": "0.18.0-ts7.1.0-dev.20260929",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@webgpu/types": "^0.1.74",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-types": "1.4.4-canary.20261019T141446",
    "supabase": "^2.122.1",
    "tailwindcss": "^4.3.5",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "7.1.0-beta"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "error"
    },
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.0 <1.5.0",
      "onFail": "error"
    }
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "fast-uri": "^3.1.9",
    "follow-redirects": "^1.16.3",
    "lodash": "^4.18.1",
    "source-map-js": "^1.2.2",
    "undici": "^8.12.2",
    "minimatch@3": {
      "brace-expansion": "^1.1.21"
    },
    "minimatch@5": {
      "brace-expansion": "^2.1.7"
    },
    "minimatch@10": {
      "brace-expansion": "^5.0.12"
    },
    "@rollup/plugin-terser": {
      "serialize-javascript": "^7.1.2"
    },
    "proxy-addr": "^2.0.8",
    "compression": "^1.8.2",
    "ip-address": "^10.7.1",
    "js-yaml": "^3.15.2",
    "qs": "^6.16.0",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "basic-ftp": "^6.2.1",
    "@modelcontextprotocol/server": "^2.3.1"
  }
}
